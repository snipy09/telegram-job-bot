# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Broadcast Channel ID or Username (e.g. @theflashjobupdates)
TELEGRAM_CHANNEL_ID=@theflashjobupdates

# Database File Path
DB_PATH=jobs_bot.db

# Background Interval (in minutes) - 24x7 instant monitoring
ALERT_CHECK_INTERVAL_MINUTES=2
CHANNEL_POST_INTERVAL_MINUTES=2

# In-Memory Jobs Cache Time-To-Live (in seconds)
JOBS_CACHE_TTL_SECONDS=120

# Default job results per search page
JOBS_PER_PAGE=5

# Max job age filter (in hours)
MAX_JOB_AGE_HOURS=2.0
